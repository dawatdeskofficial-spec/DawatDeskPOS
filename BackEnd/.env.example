# BackEnd Environment Variables
# Copy to .env and fill in values

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-here

# Server Port
PORT=5000

# CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Node Environment
NODE_ENV=development

# Email Authentication (Gmail SMTP)
EMAIL_USER=dawatdesk.official@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password
EMAIL_SERVICE=gmail

# Meta WhatsApp Business Cloud API
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dawatdesk_webhook_token
WHATSAPP_APP_SECRET=
WHATSAPP_TEST_MODE=false
WHATSAPP_ENCRYPTION_KEY=
APP_URL=https://dawatdesk-backend.vercel.app


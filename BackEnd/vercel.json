{
  "version": 2,
  "regions": ["bom1"],
  "functions": {
    "server.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
